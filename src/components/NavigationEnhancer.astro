---
import { ClientRouter } from 'astro:transitions';
---

<ClientRouter fallback="swap" />

<script>
  const root = document.documentElement;

  function startNavigation() {
    root.classList.add('jiw-route-loading');
    root.setAttribute('aria-busy', 'true');
  }

  function stopNavigation() {
    root.classList.remove('jiw-route-loading');
    root.removeAttribute('aria-busy');
  }

  document.addEventListener(
    'astro:before-preparation',
    startNavigation,
  );

  document.addEventListener(
    'astro:page-load',
    stopNavigation,
  );
</script>

<style is:global>
  html::after {
    content: '';
    position: fixed;
    z-index: 10001;
    top: 4px;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--jiw-blue, #003893);
    opacity: 0;
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: left center;
  }

  html.jiw-route-loading::after {
    opacity: 1;
    animation:
      jiw-route-progress 900ms
      cubic-bezier(0.22, 1, 0.36, 1)
      infinite;
  }

  @keyframes jiw-route-progress {
    0% {
      transform: scaleX(0.08);
      transform-origin: left center;
    }

    55% {
      transform: scaleX(0.72);
      transform-origin: left center;
    }

    100% {
      transform: scaleX(0.18);
      transform-origin: right center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html.jiw-route-loading::after {
      animation: none;
      transform: scaleX(1);
    }
  }
</style>
