---
interface Props {
  variant: 'calculator' | 'planner' | 'imt2030';
  label: string;
}

const {
  variant,
  label,
} = Astro.props;
---

<div
  class:list={[
    'client-island-fallback',
    `client-island-fallback--${variant}`,
  ]}
  role="status"
  aria-live="polite"
>
  <div class="client-island-fallback__heading">
    <span class="client-island-fallback__dot"></span>
    <strong>{label}</strong>
  </div>

  {variant === 'planner' ? (
    <div class="client-island-fallback__planner">
      <div class="client-island-fallback__map"></div>
      <div class="client-island-fallback__stack">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  ) : (
    <div class="client-island-fallback__cards">
      <span></span>
      <span></span>
      <span></span>
    </div>
  )}
</div>

<style>
  .client-island-fallback {
    min-height: 180px;
    border: 1px solid var(--jiw-border, #d2d0c8);
    border-radius: 20px;
    background: var(--jiw-surface, #f8f7f2);
    padding: 0.8rem;
    font-family: var(--jiw-font);
  }

  .client-island-fallback__heading {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.65rem;
    color: var(--jiw-muted, #626973);
    font-size: 0.72rem;
  }

  .client-island-fallback__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--jiw-blue, #003893);
    animation: jiw-fallback-pulse 1.1s ease-in-out infinite;
  }

  .client-island-fallback__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
  }

  .client-island-fallback__cards span,
  .client-island-fallback__stack span,
  .client-island-fallback__map {
    border-radius: var(--jiw-radius-small, 10px);
    background: var(--jiw-surface-soft, #f5f5f5);
    animation: jiw-fallback-pulse-surface 1.2s ease-in-out infinite;
  }

  .client-island-fallback__cards span {
    min-height: 110px;
  }

  .client-island-fallback__planner {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(190px, 0.4fr);
    gap: 0.6rem;
  }

  .client-island-fallback__map {
    min-height: 320px;
  }

  .client-island-fallback__stack {
    display: grid;
    gap: 0.55rem;
  }

  .client-island-fallback__stack span {
    min-height: 90px;
  }

  @keyframes jiw-fallback-pulse-surface {
    50% {
      background: var(--jiw-surface, #fafafa);
    }
  }

  @keyframes jiw-fallback-pulse {
    50% {
      opacity: 0.35;
    }
  }

  @media (max-width: 720px) {
    .client-island-fallback__cards,
    .client-island-fallback__planner {
      grid-template-columns: 1fr;
    }

    .client-island-fallback__map {
      min-height: 250px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .client-island-fallback__dot,
    .client-island-fallback__cards span,
    .client-island-fallback__stack span,
    .client-island-fallback__map {
      animation: none;
    }
  }
</style>
