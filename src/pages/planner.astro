---
import MapPlanner from '../components/react/planner/MapPlanner';
import PresentationBar from '../components/PresentationBar.astro';
import ClientIslandFallback from '../components/ClientIslandFallback.astro';
import NavigationEnhancer from '../components/NavigationEnhancer.astro';
import { fade } from 'astro:transitions';
import '../styles/academic-ux-fixes.css';
import '../styles/jiw-colombia-theme.css';

const presentationAnchors = [
  {href: '#modelo', label: 'Modelo'},
  {href: '#antena', label: 'Antena'},
  {href: '#mapa', label: 'Mapa'},
  {href: '#cobertura', label: 'Cobertura'},
  {href: '#terreno', label: 'Terreno'},
];


const pageTransition = fade({ duration: '140ms' });
---

<!doctype html>
<html lang="es" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <meta
      name="description"
      content="Planificador académico de enlaces 5G NR sobre mapa para escenarios en Colombia."
    />
    <title>
      Planificador sobre mapa | JIW 5G/6G Planner Colombia
    </title>
    <NavigationEnhancer />
  </head>

  <body>
    <main
      class="page-shell"
      transition:name="jiw-page"
      transition:animate={pageTransition}
    >
      <PresentationBar
        current="planner"
        anchors={presentationAnchors}
      />

      <header class="page-header">
        <nav>
          <a href="/">← JIW Planner Colombia</a>
          <a href="/calculadora">
            Calculadora RF
          </a>
        </nav>

        <p class="kicker">
          Planificador geográfico · Fases 4–7
        </p>

        <h1>
          Del mapa al comportamiento del enlace
        </h1>

        <p>
          Posición, propagación, orientación de antena,
          cobertura y relieve se integran sobre el mismo
          motor matemático del proyecto.
        </p>
      </header>

      <MapPlanner client:only="react">
        <ClientIslandFallback
          slot="fallback"
          variant="planner"
          label="Preparando planificador y mapa…"
        />
      </MapPlanner>

      <footer class="page-footer">
        <p>
          Mapa base: OpenStreetMap. La posición geográfica
          no implica disponibilidad de espectro ni
          autorización para realizar transmisiones reales.
        </p>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    background: var(--jiw-canvas);
    color: var(--jiw-ink);
  }

  body {
    margin: 0;
  }

  .page-shell {
    width: min(1380px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2rem 0 3rem;
  }

  .page-header {
    margin-bottom: 1.35rem;
    font-family: var(--jiw-font);
  }

  .page-header > * {
    max-width: 850px;
  }

  .page-header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.2rem;
  }

  .page-header a {
    color: var(--jiw-muted);
    font-size: 0.85rem;
    font-weight: 750;
    text-decoration: none;
  }

  .page-header a:hover {
    text-decoration: underline;
  }

  .page-header h1 {
    margin: 0.25rem 0 0.55rem;
    font-size: clamp(2rem, 5vw, 3.3rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .page-header p {
    color: var(--jiw-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .page-header .kicker {
    margin: 1rem 0 0.15rem;
    color: var(--jiw-muted);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .page-footer {
    margin-top: 1.2rem;
    color: var(--jiw-muted);
    font-family:
      Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 0.82rem;
  }
</style>
