---
import MapPlanner from '../components/react/planner/MapPlanner';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <meta
      name="description"
      content="Planificador académico de enlaces 5G NR sobre mapa para escenarios en Colombia."
    />
    <title>
      Planificador sobre mapa | JIW 5G/6G Planner Colombia
    </title>
  </head>

  <body>
    <main class="page-shell">
      <header class="page-header">
        <nav>
          <a href="/">← JIW Planner Colombia</a>
          <a href="/calculadora">
            Calculadora RF
          </a>
        </nav>

        <p class="kicker">
          Planificación geográfica
        </p>

        <h1>
          Del mapa al presupuesto de enlace
        </h1>

        <p>
          Ubica una estación base 5G y un equipo de usuario.
          La herramienta calcula distancia y orientación y
          utiliza esos datos como entrada del motor radio.
        </p>
      </header>

      <MapPlanner client:only="react" />

      <footer class="page-footer">
        <p>
          Mapa base: OpenStreetMap. La posición geográfica
          no implica disponibilidad de espectro ni
          autorización para realizar transmisiones reales.
        </p>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    background: #f3f5f8;
    color: #172033;
  }

  body {
    margin: 0;
  }

  .page-shell {
    width: min(1380px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2rem 0 3rem;
  }

  .page-header {
    margin-bottom: 1.35rem;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .page-header > * {
    max-width: 850px;
  }

  .page-header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.2rem;
  }

  .page-header a {
    color: #2457d6;
    font-size: 0.85rem;
    font-weight: 750;
    text-decoration: none;
  }

  .page-header a:hover {
    text-decoration: underline;
  }

  .page-header h1 {
    margin: 0.25rem 0 0.55rem;
    font-size: clamp(2rem, 5vw, 3.3rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .page-header p {
    color: #687386;
    font-size: 1rem;
    line-height: 1.6;
  }

  .page-header .kicker {
    margin: 1rem 0 0.15rem;
    color: #2457d6;
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .page-footer {
    margin-top: 1.2rem;
    color: #687386;
    font-family:
      Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 0.82rem;
  }
</style>
