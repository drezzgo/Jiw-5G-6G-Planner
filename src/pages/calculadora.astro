---
import RadioCalculator from '../components/react/calculator/RadioCalculator';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <meta
      name="description"
      content="Calculadora de enlace radio y panel de evaluación 5G NR e IMT-2030 para escenarios académicos en Colombia."
    />
    <title>
      Calculadora de enlace radio | JIW 5G/6G Planner Colombia
    </title>
  </head>

  <body>
    <main class="page-shell">
      <header class="page-header">
        <a href="/">← JIW Planner Colombia</a>
        <p class="kicker">
          Fase 3 · Calculadora de enlace radio
        </p>
        <h1>
          Diseña el enlace. Entiende el resultado.
        </h1>
        <p>
          Configura un escenario, observa cómo cambian sus
          variables y revisa si cumple las reglas técnicas
          implementadas para 5G NR o una evaluación
          experimental de IMT-2030.
        </p>
      </header>

      <RadioCalculator client:only="react" />

      <footer class="page-footer">
        <p>
          Herramienta académica para Colombia. En esta
          fase se usa pérdida de espacio libre como
          referencia ideal; los modelos de propagación
          3GPP TR 38.901 se incorporarán posteriormente.
        </p>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    background: #f3f5f8;
    color: #172033;
  }

  body {
    margin: 0;
  }

  .page-shell {
    width: min(1240px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2rem 0 3rem;
  }

  .page-header {
    margin-bottom: 1.35rem;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .page-header > * {
    max-width: 790px;
  }

  .page-header a {
    color: #2457d6;
    font-weight: 750;
    text-decoration: none;
  }

  .page-header h1 {
    margin: 0.25rem 0 0.55rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .page-header p {
    color: #687386;
    font-size: 1rem;
    line-height: 1.6;
  }

  .page-header .kicker {
    margin: 1rem 0 0.15rem;
    color: #2457d6;
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .page-footer {
    margin-top: 1.2rem;
    color: #687386;
    font-family:
      Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 0.82rem;
  }
</style>
