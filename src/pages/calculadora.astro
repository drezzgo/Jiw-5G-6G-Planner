---
import RadioCalculator from '../components/react/calculator/RadioCalculator';
import PresentationBar from '../components/PresentationBar.astro';
import ClientIslandFallback from '../components/ClientIslandFallback.astro';
import NavigationEnhancer from '../components/NavigationEnhancer.astro';
import { fade } from 'astro:transitions';
import '../styles/academic-ux-fixes.css';
import '../styles/jiw-colombia-theme.css';

const presentationAnchors = [
  {href: '#escenario', label: 'Escenario'},
  {href: '#calculo', label: 'Cálculo'},
  {href: '#evaluacion', label: 'Evaluación'},
];


const pageTransition = fade({ duration: '140ms' });
---

<!doctype html>
<html lang="es" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <meta
      name="description"
      content="Calculadora de enlace radio y panel de evaluación 5G NR e IMT-2030 para escenarios académicos en Colombia."
    />
    <title>
      Calculadora de enlace radio | JIW 5G/6G Planner Colombia
    </title>
    <NavigationEnhancer />
  </head>

  <body>
    <main
      class="page-shell"
      transition:name="jiw-page"
      transition:animate={pageTransition}
    >
      <PresentationBar
        current="calculator"
        anchors={presentationAnchors}
      />

      <header class="page-header">
        <nav>
          <a href="/">← Inicio</a>
          <a href="/planner">Planificador geográfico</a>
        </nav>
        <p class="kicker">
          Fase 3 · Calculadora de enlace radio
        </p>
        <h1>
          Diseña el enlace. Entiende el resultado.
        </h1>
        <p>
          Configura un escenario, observa cómo cambian sus
          variables y revisa si cumple las reglas técnicas
          implementadas para 5G NR o una evaluación
          experimental de IMT-2030.
        </p>
      </header>

      <RadioCalculator client:only="react">
        <ClientIslandFallback
          slot="fallback"
          variant="calculator"
          label="Cargando calculadora RF…"
        />
      </RadioCalculator>

      <footer class="page-footer">
        <p>
          Herramienta académica para Colombia. La
          calculadora permite estudiar el presupuesto de
          enlace de forma controlada; el planificador
          geográfico reutiliza el mismo motor e incorpora
          propagación, antenas, cobertura y terreno.
        </p>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    background: var(--jiw-canvas);
    color: var(--jiw-ink);
  }

  body {
    margin: 0;
  }

  .page-shell {
    width: min(1240px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2rem 0 3rem;
  }

  .page-header {
    margin-bottom: 1.35rem;
    font-family: var(--jiw-font);
  }

  .page-header > * {
    max-width: 790px;
  }

  .page-header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.2rem;
  }

  .page-header a {
    color: var(--jiw-muted);
    font-weight: 750;
    text-decoration: none;
  }

  .page-header h1 {
    margin: 0.25rem 0 0.55rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .page-header p {
    color: var(--jiw-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .page-header .kicker {
    margin: 1rem 0 0.15rem;
    color: var(--jiw-muted);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .page-footer {
    margin-top: 1.2rem;
    color: var(--jiw-muted);
    font-family:
      Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 0.82rem;
  }
</style>
